# =============================================================================
# ACID-FTS Repository .gitignore
# Strictly excludes all plots, results, generated tables, and binary data files
# =============================================================================

# Output, Results, and Plot Directories
output*/
results*/
plots*/
figures*/
tables*/
logs*/
catboost_info/
optuna_studies/

# Image & Plot Formats
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.eps
*.bmp
*.tiff
*.pdf

# Result Tables & Serialized Outputs
*.csv
*.xlsx
*.xls
*.tsv
*.tex
*.npy
*.npz
*.pkl
*.joblib
*.h5
*.hdf5
*.nc
*.tif

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp

